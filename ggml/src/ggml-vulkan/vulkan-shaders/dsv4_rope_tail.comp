#version 450

#include "types.glsl"

#extension GL_EXT_shader_16bit_storage : require

#include "rope_params.glsl"

layout(local_size_x = 1, local_size_y = 256, local_size_z = 1) in;

layout(binding = 0) readonly buffer X {A_TYPE src_data[];};
layout(binding = 1) readonly buffer Y {int32_t pos_data[];};
layout(binding = 2) readonly buffer Z {float freq_factors[];};
layout(binding = 3) writeonly buffer D {A_TYPE dst_data[];};

layout(push_constant) uniform parameter {
    rope_params pc;
};

#include "rope_funcs.glsl"

void main() {
    const uint row = gl_GlobalInvocationID.x + 32768 * gl_GlobalInvocationID.z;
    if (row >= pc.nrows) {
        return;
    }

    const uint i3 = row / (pc.ne01 * pc.ne02);
    const uint tmp = row - i3 * pc.ne01 * pc.ne02;
    const uint i2 = tmp / pc.ne01;
    const uint i1 = tmp - i2 * pc.ne01;

    const uint nb01 = pc.nb01 / A_TYPE_SIZE;
    const uint nb11 = pc.nb11 / A_TYPE_SIZE;

    const int32_t theta_base = pos_data[i2];

    const uint n_nope = pc.ne00 - pc.n_dims;

    // Process all elements in this row
    for (uint i0_base = 0; i0_base < pc.ne00; i0_base += 1) {
        const uint src_idx = i0_base + nb01 * i1 + pc.ne01 * nb01 * i2 + pc.ne01 * pc.ne02 * nb01 * i3;
        const uint dst_idx = i0_base + nb11 * i1 + pc.ne01 * nb11 * i2 + pc.ne01 * pc.ne02 * nb11 * i3;

        // Copy non-rotated elements (nope part) directly
        if (i0_base < n_nope) {
            dst_data[dst_idx] = src_data[src_idx];
            continue;
        }

        const uint r = i0_base - n_nope;

        // Apply rotary position embedding
        if (pc.rope_mode == 2) { // Neox mode
            const uint n_half = pc.n_dims / 2;
            if (r >= n_half) {
                dst_data[dst_idx] = src_data[src_idx];
                continue;
            }

            const uint ic = r;
            const uint rel_i0 = 2 * ic;
            const float theta = theta_base * pow(pc.freq_base, pc.theta_scale * rel_i0);
            const float freq_factor = pc.has_ff != 0 ? freq_factors[ic] : 1.0f;

            float cos_theta, sin_theta;
            rope_yarn(theta / freq_factor, rel_i0, cos_theta, sin_theta, pc);

            if (pc.is_back != 0) {
                sin_theta = -sin_theta;
            }

            // Process the pair: positions (n_nope + ic) and (n_nope + ic + n_half)
            const uint j0 = n_nope + ic;
            const uint j1 = n_nope + ic + n_half;

            const uint src_idx0 = j0 + nb01 * i1 + pc.ne01 * nb01 * i2 + pc.ne01 * pc.ne02 * nb01 * i3;
            const uint src_idx1 = j1 + nb01 * i1 + pc.ne01 * nb01 * i2 + pc.ne01 * pc.ne02 * nb01 * i3;
            const uint dst_idx0 = j0 + nb11 * i1 + pc.ne01 * nb11 * i2 + pc.ne01 * pc.ne02 * nb11 * i3;
            const uint dst_idx1 = j1 + nb11 * i1 + pc.ne01 * nb11 * i2 + pc.ne01 * pc.ne02 * nb11 * i3;

            const float x0 = float(src_data[src_idx0]);
            const float x1 = float(src_data[src_idx1]);

            dst_data[dst_idx0] = A_TYPE(x0 * cos_theta - x1 * sin_theta);
            dst_data[dst_idx1] = A_TYPE(x0 * sin_theta + x1 * cos_theta);

            // Skip the second element of the pair to avoid double-processing
            i0_base += 1;
        } else { // Interleaved mode
            if ((r & 1) != 0) {
                dst_data[dst_idx] = src_data[src_idx];
                continue;
            }

            const uint ic = r / 2;
            const float theta = theta_base * pow(pc.freq_base, pc.theta_scale * r);
            const float freq_factor = pc.has_ff != 0 ? freq_factors[ic] : 1.0f;

            float cos_theta, sin_theta;
            rope_yarn(theta / freq_factor, r, cos_theta, sin_theta, pc);

            if (pc.is_back != 0) {
                sin_theta = -sin_theta;
            }

            // Process the pair: positions (n_nope + r) and (n_nope + r + 1)
            const uint j0 = n_nope + r;
            const uint j1 = j0 + 1;

            const uint src_idx0 = j0 + nb01 * i1 + pc.ne01 * nb01 * i2 + pc.ne01 * pc.ne02 * nb01 * i3;
            const uint src_idx1 = j1 + nb01 * i1 + pc.ne01 * nb01 * i2 + pc.ne01 * pc.ne02 * nb01 * i3;
            const uint dst_idx0 = j0 + nb11 * i1 + pc.ne01 * nb11 * i2 + pc.ne01 * pc.ne02 * nb11 * i3;
            const uint dst_idx1 = j1 + nb11 * i1 + pc.ne01 * nb11 * i2 + pc.ne01 * pc.ne02 * nb11 * i3;

            const float x0 = float(src_data[src_idx0]);
            const float x1 = float(src_data[src_idx1]);

            dst_data[dst_idx0] = A_TYPE(x0 * cos_theta - x1 * sin_theta);
            dst_data[dst_idx1] = A_TYPE(x0 * sin_theta + x1 * cos_theta);

            // Skip the second element of the pair to avoid double-processing
            i0_base += 1;
        }
    }
}